FROM node:18-alpine
WORKDIR /app

COPY ./calculator.tm.json .
COPY ./http/express .

# The workspace-root "test-things" file: dependency resolves to "/" inside the image and crashes npm.
RUN npm pkg delete dependencies.test-things && rm -f package-lock.json && npm install

ENV TM_PATH="./calculator.tm.json"

CMD ["node", "http-simple-calculator.js"]
